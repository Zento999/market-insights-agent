        "url": "=https://api.massive.com/v2/reference/news?published_utc.gte={{ $now.minus({ hours: 12 }).toUTC().toFormat(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") }}&order=desc&sort=published_utc&limit=300",
