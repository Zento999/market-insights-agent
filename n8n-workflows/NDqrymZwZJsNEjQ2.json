      "credentials": {
        "httpHeaderAuth": {
          "id": "IfI77F5wOXTyGEDF",
          "name": "Massive API"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH incoming AS (\n  SELECT r.article_url AS url, r.title, r.description AS summary,\n         r.publisher->>'name' AS source, r.published_utc AS published_at, r.tickers\n  FROM jsonb_to_recordset($data${{ JSON.stringify($json.results || []) }}$data$::jsonb)\n       AS r(article_url text, title text, description text, publisher jsonb,\n            published_utc timestamptz, tickers jsonb)\n  WHERE r.article_url IS NOT NULL AND r.title IS NOT NULL\n),\nmatches AS (\n  SELECT DISTINCT i.url, s.id AS stock_id\n  FROM incoming i\n  CROSS JOIN LATERAL jsonb_array_elements_text(COALESCE(i.tickers, '[]'::jsonb)) AS t(symbol)\n  JOIN stocks s ON s.symbol = t.symbol AND s.is_active\n),\nnew_articles AS (\n  INSERT INTO news_articles (url, title, summary, source, published_at)\n  SELECT DISTINCT ON (i.url) i.url, i.title, i.summary, i.source, i.published_at\n  FROM incoming i\n  WHERE i.url IN (SELECT url FROM matches)\n  ON CONFLICT (url) DO NOTHING\n  RETURNING id, url\n),\nnew_links AS (\n  INSERT INTO news_stocks (article_id, stock_id)\n  SELECT na.id, m.stock_id\n  FROM new_articles na\n  JOIN matches m ON m.url = na.url\n  ON CONFLICT DO NOTHING\n  RETURNING 1\n)\nSELECT (SELECT COUNT(*) FROM incoming)            AS fetched,\n       (SELECT COUNT(DISTINCT url) FROM matches)  AS relevant,\n       (SELECT COUNT(*) FROM new_articles)        AS new_articles,\n       (SELECT COUNT(*) FROM new_links)           AS new_links;",
        "options": {}
      },
