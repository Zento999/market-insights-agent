    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "ดึงข่าวล่าสุดที่เกี่ยวข้องกับหุ้น 1 ตัว ใช้เมื่อต้องการรู้สาเหตุหรือเหตุการณ์ของหุ้นตัวนั้น",
        "operation": "executeQuery",
        "query": "SELECT s.symbol, a.published_at::date AS date, a.source, a.title, LEFT(a.summary, 300) AS summary, NULL AS note\nFROM news_stocks ns\nJOIN stocks s ON s.id = ns.stock_id\nJOIN news_articles a ON a.id = ns.article_id\nWHERE s.symbol = UPPER($1)\nUNION ALL\nSELECT UPPER($1), NULL, NULL, NULL, NULL, 'ไม่มีข่าวของ ' || UPPER($1) || ' ในฐานข้อมูล'\nWHERE NOT EXISTS (\n  SELECT 1 FROM news_stocks ns JOIN stocks s ON s.id = ns.stock_id WHERE s.symbol = UPPER($1))\nORDER BY date DESC NULLS FIRST\nLIMIT 5;",
        "options": {
          "queryReplacement": "={{ $fromAI('symbol', 'ticker ของหุ้น เช่น NVDA หรือ MU', 'string') }}"
        }
