    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "ดึงราคาปิดรายวันของหุ้น 1 ตัวย้อนหลัง ใช้เมื่อต้องการรู้ราคาหรือการเปลี่ยนแปลงของราคา",
        "operation": "executeQuery",
        "query": "SELECT s.symbol, p.trade_date, p.close, p.volume, NULL AS note\nFROM daily_prices p JOIN stocks s ON s.id = p.stock_id\nWHERE s.symbol = UPPER($1)\nUNION ALL\nSELECT UPPER($1), NULL, NULL, NULL,\n       'ไม่พบหุ้น ' || UPPER($1) || ' ในระบบ (ติดตามเฉพาะ 40 ตัวใน watchlist)'\nWHERE NOT EXISTS (SELECT 1 FROM stocks WHERE symbol = UPPER($1))\nORDER BY trade_date DESC NULLS FIRST\nLIMIT LEAST($2::int, 60);",
        "options": {
          "queryReplacement": "={{ $fromAI('symbol', 'ticker ของหุ้น เช่น NVDA หรือ MU', 'string') }}, {{ $fromAI('days', 'จำนวนวันย้อนหลัง 1 ถึง 60', 'number') }}"
        }
