    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH q AS (\n  SELECT '{{ JSON.stringify($json.embeddings[0]) }}'::vector AS v\n),\ntop AS (\n  SELECT e.article_id, e.embedding <=> q.v AS distance\n  FROM news_embeddings e, q\n  ORDER BY e.embedding <=> q.v\n  LIMIT 5\n)\nSELECT ROUND(t.distance::numeric, 3) AS distance,\n       a.title,\n       (SELECT string_agg(s.symbol, ', ')\n          FROM news_stocks ns JOIN stocks s ON s.id = ns.stock_id\n         WHERE ns.article_id = a.id) AS stocks\nFROM top t\nJOIN news_articles a ON a.id = t.article_id\nORDER BY t.distance;",
        "options": {}
      },
