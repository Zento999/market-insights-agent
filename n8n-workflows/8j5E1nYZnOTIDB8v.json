    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH saved AS (\n  INSERT INTO daily_prices (stock_id, trade_date, open, high, low, close, volume)\n  SELECT s.id,\n         (to_timestamp(r.t / 1000.0) AT TIME ZONE 'America/New_York')::date,\n         r.o, r.h, r.l, r.c, round(r.v)::bigint\n  FROM jsonb_to_recordset($data${{ JSON.stringify($json.results || []) }}$data$::jsonb)\n       AS r(o numeric, h numeric, l numeric, c numeric, v numeric, t bigint)\n  JOIN stocks s ON s.symbol = '{{ $json.ticker }}'\n   AND (s.listed_since IS NULL\n        OR (to_timestamp(r.t / 1000.0) AT TIME ZONE 'America/New_York')::date >= s.listed_since)\n  ON CONFLICT (stock_id, trade_date) DO UPDATE SET\n      open = EXCLUDED.open, high = EXCLUDED.high, low = EXCLUDED.low,\n      close = EXCLUDED.close, volume = EXCLUDED.volume, fetched_at = now()\n  RETURNING 1\n)\nSELECT '{{ $json.ticker }}' AS symbol, COUNT(*) AS rows_saved FROM saved;",
        "options": {}
      },
