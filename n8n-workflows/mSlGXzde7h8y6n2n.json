    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO daily_prices (stock_id, trade_date, open, high, low, close, volume)\nSELECT s.id,\n       (to_timestamp(r.t / 1000.0) AT TIME ZONE 'America/New_York')::date,\n       r.o, r.h, r.l, r.c,\n       round(r.v)::bigint\nFROM jsonb_to_recordset($data${{ JSON.stringify($json.results || []) }}$data$::jsonb)\n     AS r(\"T\" text, o numeric, h numeric, l numeric, c numeric, v numeric, t bigint)\nJOIN stocks s ON s.symbol = r.\"T\" AND s.is_active\nON CONFLICT (stock_id, trade_date) DO UPDATE SET\n    open = EXCLUDED.open, high = EXCLUDED.high, low = EXCLUDED.low,\n    close = EXCLUDED.close, volume = EXCLUDED.volume, fetched_at = now()\nRETURNING stock_id, trade_date, close;",
        "options": {}
