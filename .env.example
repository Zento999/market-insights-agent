# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n

# n8n - สุ่มตัวอักษร hex 64 ตัว ห้ามเปลี่ยนหลังใช้งานแล้ว!
N8N_ENCRYPTION_KEY=change_me

# ngrok
NGROK_AUTHTOKEN=change_me
NGROK_DOMAIN=your-domain.ngrok-free.app

# Web
WEB_DB_PASSWORD=change_me
N8N_WEBHOOK_SECRET=change_me
